vec3 hdr_linear(vec3 linear,float highlights,float shadows,float whites,float blacks,float base){
    if(highlights==0.&&shadows==0.&&whites==0.&&blacks==0.)return linear;
    float l=max(base,0.);
    float gain=1.;
    float zone=hdr_zone_gain(l,shadows,.18,1.7,3.3,false);gain*=zone;l*=zone;
    zone=hdr_zone_gain(l,highlights,.18,1.7,4.3,true);gain*=zone;l*=zone;
    zone=hdr_zone_gain(l,blacks,.04,1.4,1.8,false);gain*=zone;l*=zone;
    zone=hdr_zone_gain(l,whites,.45,1.4,2.2,true);gain*=zone;
    return linear*gain;
}
vec3 toLab(vec3 c){
