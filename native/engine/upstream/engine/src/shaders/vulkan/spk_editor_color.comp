vec3 before_tone(uint i){
    vec3 c=vec3(src.v[3u*i],src.v[3u*i+1u],src.v[3u*i+2u]);
    if(u.v[0]!=0.){
        if(u.v[13]==0.)c=decode(c);else if(u.v[13]==2.)c=mix(c/16.,sign(c)*pow(abs(c),vec3(1.8)),greaterThan(abs(c),vec3(16./512.)));else if(u.v[13]==3.)c=sign(c)*pow(abs(c),vec3(2.2));
        c=vec3(dot(c,vec3(u.v[4],u.v[5],u.v[6])),dot(c,vec3(u.v[7],u.v[8],u.v[9])),dot(c,vec3(u.v[10],u.v[11],u.v[12])));
        c=encode(c*u.v[3]);
    }else if(u.v[3]!=1.)c=encode(decode(c)*u.v[3]);
    if(u.v[1]!=0.){
        if(u.v[20]!=0.)c=(c-.5)*(1.+u.v[20])+.5;
        if(u.v[21]!=0.)c*=vec3(1.+u.v[21],1.,1.-u.v[21]);
        if(u.v[22]!=0.)c=lum(c)+(c-lum(c))*(1.+u.v[22]);
        if(u.v[23]!=0.){float ch=clamp(max(c.r,max(c.g,c.b))-min(c.r,min(c.g,c.b)),0,1);c=lum(c)+(c-lum(c))*(1.+u.v[23]*(1.-ch));}
    }
