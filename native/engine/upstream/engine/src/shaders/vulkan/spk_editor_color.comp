}
float detail_base(uint i,vec3 c){
    if(u.v[112]!=0.)return tonebase.v[i];
    float center=log2(max(lum(decode(c)),1e-8)),total=0.,normal=0.;
    ivec2 p=ivec2(int(i%m.v[1]),int(i/m.v[1]));
    ivec2 radius=max(ivec2(1),ivec2(floor(vec2(48.)/max(vec2(u.v[34],u.v[35]),vec2(1e-6))+.5)));
    ivec2 limit=ivec2(int(m.v[1])-1,int(m.v[2])-1);
    for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
        ivec2 q=clamp(p+ivec2(x,y)*radius,ivec2(0),limit);
        float sample_l=log2(max(lum(decode(before_tone(uint(q.y)*m.v[1]+uint(q.x)))),1e-8));
        float delta=(sample_l-center)/.7,square=delta*delta;
        float weight=float((x==0?2:1)*(y==0?2:1))/(1.+square*square);
        total+=sample_l*weight;normal+=weight;
    }
    return exp2(center+(total/normal-center)*.65);
}
void main(){
    uint i=index1D();if(i>=m.v[0])return;vec3 c=before_tone(i);
    if(u.v[1]!=0.){
        if(u.v[24]!=0.||u.v[25]!=0.||u.v[26]!=0.||u.v[27]!=1.||u.v[28]!=1.){
            vec3 linear=decode(c);
            float base=(u.v[24]!=0.||u.v[25]!=0.)?detail_base(i,c):max(lum(linear),0.);
            vec3 lin=hdr_linear(linear,u.v[24],u.v[25],0.,0.,base);
            lin=(lin-u.v[26])/max(.05,u.v[27]-u.v[26]);if(u.v[28]!=1.)lin=pow(max(lin,vec3(0)),vec3(1./u.v[28]));c=encode(lin);
        }
        if(u.v[40]!=0.){
            vec3 linear=decode(c);float l=max(lum(linear),0.),q=clamp(encode(vec3(l)).r,0,1);
            float weight=pow(max(4.*q*(1.-q),0.),1.5);c=encode(linear*exp2(1.2*u.v[40]*weight));
        }
        if(u.v[38]!=0.||u.v[39]!=0.){
            vec3 linear=decode(c);float l=max(lum(linear),0.),q=clamp(l,0,1);
            linear=hdr_linear(linear,0.,0.,u.v[38],u.v[39],l);c=encode(linear);
        }
        c=vec3(level(c.r,1u),level(c.g,2u),level(c.b,3u));
        c=vec3(level(c.r,0u),level(c.g,0u),level(c.b,0u));
        if(u.v[29]!=0.){vec2 xy=vec2(float(i%m.v[1])*u.v[34]+u.v[32],float(i/m.v[1])*u.v[35]+u.v[33]);vec2 p=2.*xy/max(vec2(1),vec2(m.v[3],m.v[4])-1.)-1.;c*=1.-clamp(dot(p,p)*.4,0,.8)*u.v[29];}
        if(u.v[36]!=0.){vec3 lin=decode(c);float amount=u.v[36];if(amount>0.)lin=(lin-.04*amount)/max(.2,1.-.25*amount);else lin=mix(lin,vec3(1),-.10*amount);c=encode(lin);}
        if(u.v[37]!=0.){float w=pow(1.-clamp(lum(decode(c)),0,1),2.);vec3 gain=exp2(vec3(u.v[37]*.15,-u.v[37]*.15,u.v[37]*.15)*w);gain/=dot(gain,vec3(.2126,.7152,.0722));c=encode(decode(c)*gain);}
        if(u.v[61]!=0.)c=hsl(c);
