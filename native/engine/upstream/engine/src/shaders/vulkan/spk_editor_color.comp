    lms=sign(lms)*pow(abs(lms),vec3(1./3.));
    return vec3(dot(lms,vec3(.2104542553,.7936177850,-.0040720468)),dot(lms,vec3(1.9779984951,-2.4285922050,.4505937099)),dot(lms,vec3(.0259040371,.7827717662,-.8086757660)));
}
vec3 fromLab(vec3 c){
    vec3 q=vec3(c.x+.3963377774*c.y+.2158037573*c.z,c.x-.1055613458*c.y-.0638541728*c.z,c.x-.0894841775*c.y-1.291485548*c.z);q=q*q*q;
    return vec3(dot(q,vec3(4.0767416621,-3.3077115913,.2309699292)),dot(q,vec3(-1.2684380046,2.6097574011,-.3413193965)),dot(q,vec3(-.0041960863,-.7034186147,1.7076147010)));
}
bool fits(vec3 c){return all(greaterThanEqual(c,vec3(0)))&&all(lessThanEqual(c,vec3(1)));}
float curve(float x,uint row){float p=clamp(x,0,1)*4095.;uint k=uint(floor(p));return mix(curves.v[row*4096u+k],curves.v[row*4096u+min(k+1u,4095u)],fract(p));}
float level(float x,uint row){if(u.v[108u+row]==0.)return x;uint k=88u+5u*row;float q=clamp((x-u.v[k])/(u.v[k+1u]-u.v[k]),0,1);if(u.v[k+2u]!=1.)q=pow(q,1./u.v[k+2u]);return mix(u.v[k+3u],u.v[k+4u],q);}
vec3 band(uint i){return vec3(u.v[64u+3u*i],u.v[65u+3u*i],u.v[66u+3u*i]);}
vec3 hsl(vec3 c){
    vec3 b=clamp(c,0,1);float hi=max(b.r,max(b.g,b.b)),lo=min(b.r,min(b.g,b.b)),ch=hi-lo;if(ch<=1e-7)return c;
    float h=hi==b.r?(b.g-b.b)/ch:hi==b.g?(b.b-b.r)/ch+2.:(b.r-b.g)/ch+4.;h=mod(h*60.+360.,360.);
    const float a[9]=float[9](0,30,60,120,180,240,270,300,360);uint k=0u;for(uint j=1u;j<8u;++j)if(h>=a[j])k=j;
    float t=(h-a[k])/(a[k+1u]-a[k]);vec3 d=mix(band(k),band((k+1u)%8u),.5-.5*cos(t*3.141592653589793));
