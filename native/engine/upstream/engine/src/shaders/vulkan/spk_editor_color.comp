uint index1D(){return gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x)+gl_GlobalInvocationID.x;}
vec3 decode(vec3 c){return mix(c/12.92,pow(max((c+.055)/1.055,vec3(0)),vec3(2.4)),greaterThan(c,vec3(.04045)));}
vec3 encode(vec3 c){return mix(c*12.92,1.055*pow(max(c,vec3(0)),vec3(1./2.4))-.055,greaterThan(c,vec3(.0031308)));}
float lum(vec3 c){return dot(c,vec3(.2126,.7152,.0722));}
float hdr_zone_gain(float l,float amount,float pivot,float rolloff,float stops,bool upper){
    if(amount==0.)return 1.;
