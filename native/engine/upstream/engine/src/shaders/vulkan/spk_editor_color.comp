            if(u.v[19]!=0.){float t=clamp(l+u.v[59],0,1);vec3 q=(t-vec3(0,.5,1))/u.v[60],w=exp(-.5*q*q);w/=max(dot(w,vec3(1)),1e-8);vec3 d=vec3(u.v[50],u.v[51],u.v[52])*w.x+vec3(u.v[53],u.v[54],u.v[55])*w.y+vec3(u.v[56],u.v[57],u.v[58])*w.z+vec3(u.v[114],u.v[115],u.v[116]);lab+=d*sqrt(clamp(4.*l*(1.-l),0,1));lab.x=clamp(lab.x,0,1);}
